# ---------------------------------------------------------------
# AgentPulse environment configuration
# Copy to .env:  cp .env.example .env
# ---------------------------------------------------------------

# true  -> fake LLM + fake Tavily responses (no keys, no network needed)
# false -> real calls through Bifrost and Tavily
MOCK_MODE=true

# --- LLM providers (consumed by Bifrost, never by the backend) ---
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Ollama running on your host machine (reached from inside Docker)
OLLAMA_URL=http://host.docker.internal:11434

# --- Tavily (live web search / claim verification) ---
TAVILY_API_KEY=

# --- Public demo mode ---
# With MOCK_MODE=true and a code set here, requests are mock by default and the header
# "X-Access-Code: <code>" (dashboard sidebar: "Unlock live mode") switches them to live.
LIVE_ACCESS_CODE=

# --- PostgreSQL ---
POSTGRES_USER=agentpulse
POSTGRES_PASSWORD=agentpulse
POSTGRES_DB=agentpulse

# --- Model used by the `judge` scorer (live mode) ---
JUDGE_MODEL=groq/openai/gpt-oss-120b

# --- Stale-answer detector (live mode) ---
# Model that extracts claims and judges them against Tavily sources, then fallbacks tried in order
# when it is rate-limited (each Groq model has its own daily token quota).
FRESHNESS_MODEL=groq/openai/gpt-oss-120b
FRESHNESS_FALLBACK_MODELS=groq/openai/gpt-oss-20b,groq/qwen/qwen3.8-27b
# Tavily depth for the automatic checks during benchmark runs: advanced (2 credits, better sources)
# or basic (1 credit). Each distinct claim is searched once per run.
FRESHNESS_SEARCH_DEPTH=advanced

# --- Request timeouts (seconds) ---
LLM_TIMEOUT_S=120
SEARCH_TIMEOUT_S=20
