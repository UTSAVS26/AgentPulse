# ---------------------------------------------------------------
# AgentPulse environment configuration
# Copy to .env:  cp .env.example .env
# ---------------------------------------------------------------

# true  -> fake LLM + fake Tavily responses (no keys, no network needed)
# false -> real calls through Bifrost and Tavily
MOCK_MODE=true

# --- LLM providers (consumed by Bifrost, never by the backend) ---
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Ollama running on your host machine (reached from inside Docker)
OLLAMA_URL=http://host.docker.internal:11434

# --- Tavily (live web search / claim verification) ---
TAVILY_API_KEY=

# --- Public demo mode ---
# With MOCK_MODE=true and a code set here, requests are mock by default and the header
# "X-Access-Code: <code>" (dashboard sidebar: "Unlock live mode") switches them to live.
LIVE_ACCESS_CODE=

# --- PostgreSQL ---
POSTGRES_USER=agentpulse
POSTGRES_PASSWORD=agentpulse
POSTGRES_DB=agentpulse

# --- Bifrost management API ---
# Lets AgentPulse register hosted providers you add on the Models page (OpenAI, Anthropic, Gemini…) inside
# Bifrost at runtime, so their calls go through the gateway. Empty = those connections are called directly.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(24))"
BIFROST_SETUP_TOKEN=

# --- Model connections (bring your own model) ---
# Encrypts the API keys you store for your own endpoints. Leave empty to auto-generate one (kept in a Docker
# volume); keys saved under one secret can't be read with another. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
APP_SECRET=

# --- Demo data: on an empty database, seed 2 mock benchmark runs, a mock Freshness Bench run + 2 example checks ---
SEED_DEMO_DATA=true

# --- Model used by the `judge` scorer (live mode) ---
# Judges are strong models from labs the default agents don't use (no self-grading bias). Paid via OpenRouter.
JUDGE_MODEL=openrouter/anthropic/claude-sonnet-5.5
# `jury` scorer: three judges from different labs; the majority decides and agreement (Fleiss' kappa) is reported.
JURY_MODELS=openrouter/anthropic/claude-opus-5.5,openrouter/google/gemini-3.1-pro-preview,openrouter/deepseek/deepseek-v4-pro

# --- Stale-answer detector (live mode) ---
# Model that extracts claims and judges them against Tavily sources, then fallbacks tried in order
# when it is rate-limited (each Groq model has its own daily token quota).
FRESHNESS_MODEL=openrouter/anthropic/claude-sonnet-5.5
FRESHNESS_FALLBACK_MODELS=groq/openai/gpt-oss-120b,groq/openai/gpt-oss-20b,openrouter/nvidia/nemotron-3.5-lightning:free
# Tavily depth for the automatic checks during benchmark runs: advanced (2 credits, better sources)
# or basic (1 credit). Each distinct claim is searched once per run.
FRESHNESS_SEARCH_DEPTH=advanced

# --- Live Freshness Bench (docs/freshbench.md) ---
# Questions per category x event-age cell (6 x 6 cells). Live generation: 1 Tavily credit per cell.
FRESHBENCH_PER_CELL=2
# Daily pulse: generate today's bench and run it after this UTC hour (empty = off; spends credits live).
FRESHBENCH_PULSE_HOUR_UTC=
FRESHBENCH_PULSE_AGENTS=2,4
FRESHBENCH_DRIFT_POINTS=10

# --- Request timeouts (seconds) ---
LLM_TIMEOUT_S=120
SEARCH_TIMEOUT_S=20
