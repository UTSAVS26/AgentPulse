{
  "$schema": "https://www.getbifrost.ai/schema",
  "source_of_truth": "config.json",
  "disable_onboarding": true,
  "client": {
    "drop_excess_requests": false,
    "enable_logging": true,
    "enforce_auth_on_inference": false
  },
  "providers": {
    "groq": {
      "keys": [
        {
          "name": "groq-primary",
          "value": "env.GROQ_API_KEY",
          "models": [
            "*"
          ],
          "weight": 1.0
        }
      ]
    },
    "openrouter": {
      "keys": [
        {
          "name": "openrouter-primary",
          "value": "env.OPENROUTER_API_KEY",
          "models": [
            "*"
          ],
          "weight": 1.0
        }
      ]
    },
    "ollama": {
      "network_config": {
        "allow_private_network": true
      },
      "keys": [
        {
          "name": "ollama-local",
          "value": "",
          "models": [
            "*"
          ],
          "weight": 1.0,
          "ollama_key_config": {
            "url": "env.OLLAMA_URL"
          }
        }
      ]
    },
    "chaos": {
      "keys": [
        {
          "name": "chaos-key",
          "value": "env.CHAOS_TOKEN",
          "models": [
            "*"
          ],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://backend:8000/chaos",
        "allow_private_network": true,
        "max_retries": 0
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "chat_completion": true,
          "chat_completion_stream": false,
          "list_models": false
        }
      }
    }
  },
  "mcp": {
    "client_configs": [
      {
        "name": "tavily",
        "connection_type": "http",
        "connection_string": "https://mcp.tavily.com/mcp/",
        "auth_type": "headers",
        "headers": {
          "Authorization": "env.TAVILY_AUTH"
        },
        "tools_to_execute": [
          "tavily_search",
          "tavily_extract"
        ],
        "allow_by_default": true
      }
    ],
    "tool_manager_config": {
      "disable_auto_tool_inject": true,
      "tool_execution_timeout": 30
    }
  }
}
